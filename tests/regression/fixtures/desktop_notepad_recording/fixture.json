    "expected_steps": [
      {"action": "activate_window", "executor": "windows"},
      {"action": "type_text", "executor": "windows"},
      {"action": "press_hotkey", "executor": "windows"}
    ],
    "expected_idempotency_keys": [
      "rec-01-activate_window-bc6a7b40",
      "rec-02-type_text-6cb867dc",
      "rec-03-press_hotkey-8da3194b"
    ]
