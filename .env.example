DATABASE_URL=sqlite+aiosqlite:///./rpa.db
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-here
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
DEV_AUTH_BYPASS=false
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost
DOCKER_SANDBOX_IMAGE=rpa-sandbox:latest
EXECUTION_TIMEOUT=300
MAX_RETRY=3
# 诊断截图：单张截图的超时（毫秒）。整页截图超时后会自动降级为视口截图。
SCREENSHOT_ENABLED=true
SCREENSHOT_TIMEOUT_MS=15000
SCREENSHOT_FULL_PAGE=true
DESKTOP_REPAIR_ATTEMPTS=2
# 网页流程允许写入结果文件的目录（多个目录用分号分隔）；
# 桌面代理设置里已授权的文档目录同样可用
WEB_EXPORT_DIRS=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=notifications@example.com
SMTP_DEFAULT_RECIPIENT=
# Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Web browser mode: auto, edge, or isolated.
# In desktop mode, auto reuses the signed-in Microsoft Edge profile.
BROWSER_MODE=auto
BROWSER_HEADLESS=true
EDGE_EXECUTABLE_PATH=
EDGE_USER_DATA_DIR=
EDGE_PROFILE_DIRECTORY=auto

# 可靠性与 MCP 功能开关（默认关闭，逐阶段灰度启用）
# 规划前先观察真实页面/窗口
OBSERVE_BEFORE_PLAN=false
# 已废弃：仅为旧配置可继续加载而保留，不再影响结构化执行
WEB_STRUCTURED_ACTIONS=false
# 新 execution_mode=structured 工作流的执行开关；关闭时阻断，不回退代码
STRUCTURED_EXECUTION_ENABLED=true
# 历史 legacy_code 工作流应急开关
LEGACY_CODE_EXECUTION_ENABLED=true
# 检测到登录失效时暂停执行，等待人工登录后继续
# 检测到登录失效时暂停执行并创建 HumanTask；旧 resume-after-login 入口保留兼容
AUTH_REQUIRED_PAUSE=true
# 失败时只修复当前步骤及其后置条件
STEP_LEVEL_REPAIR=false
# 结构化网页流程单次执行内允许的自动修复轮数
WEB_REPAIR_ATTEMPTS=2
# 浏览器/桌面录制式生成
RECORDER_MODE=false
# 接入外部 MCP 工具（默认值；可在应用「连接器与 MCP」页面开关，应用内设置优先）
MCP_CLIENT=false
# MCP 客户端：单次调用超时（秒）、全局并发上限、未知工具默认风险级别
MCP_CALL_TIMEOUT=30
MCP_MAX_CONCURRENCY=2
MCP_DEFAULT_RISK=mutating
# 允许 stdio 传输（本地子进程，视为高权限插件）
MCP_STDIO_ENABLED=false
MCP_CATALOG_MAX_TOOLS=50
# 本地模式总开关：仅恢复已有 owner/workspace 绑定且 auto_start=true 的应用
LOCAL_APP_AUTO_START_ENABLED=true
# 把平台有限工具导出为 MCP Server（POST /mcp）
MCP_SERVER_EXPORT=false
MCP_SERVER_TOKEN=
MCP_SERVER_ALLOW_MUTATING=false

# 阶段 5（批次 A）：指标、失败分类与阈值告警
METRICS_API=false
METRICS_ALERTS_ENABLED=false
METRICS_ALERT_EMAIL=
METRICS_ALERT_WEBHOOK=
# JSON 覆盖默认阈值，例如 {"locator_failure_rate": {"threshold": 0.1}}
METRICS_ALERT_THRESHOLDS=
METRICS_ALERT_WINDOW_SECONDS=3600
METRICS_ALERT_COOLDOWN_SECONDS=3600
METRICS_ALERT_INTERVAL_SECONDS=300
# 本地假 SMTP / 明文 relay 调试时可关闭 STARTTLS
SMTP_START_TLS=true

# 阶段 5（批次 B）：工作区隔离与任务队列
WORKSPACE_ISOLATION=false
DEFAULT_WORKSPACE_NAME=默认工作区
WORKSPACE_DEFAULT_MAX_CONCURRENT_EXECUTIONS=2
WORKSPACE_DEFAULT_MAX_CONCURRENT_AGENT_TASKS=2
# PostgreSQL 示例（需安装 asyncpg）：postgresql+asyncpg://user:pass@host:5432/nlrpa
EXTERNAL_QUEUE=false
QUEUE_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0
QUEUE_POLL_TIMEOUT=5

# 阶段 5（批次 C）：插件供应链与启动自检
PLUGIN_INTEGRITY=false
PLUGIN_REQUIRE_SIGNATURE=false
PLUGIN_SIGNING_SECRET=
STARTUP_SELF_CHECK=true
STARTUP_SELF_CHECK_STRICT=false
